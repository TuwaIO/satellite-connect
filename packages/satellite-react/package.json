  "description": "Layer 4 (L4) of the TUWA Ecosystem. React state hooks and context providers for orchestrating framework-agnostic Satellite wallet connector instances.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./evm": {
      "types": "./dist/evm/index.d.ts",
      "import": "./dist/evm/index.js",
      "require": "./dist/evm/index.cjs",
      "default": "./dist/evm/index.js"
    },
    "./solana": {
      "types": "./dist/solana/index.d.ts",
      "import": "./dist/solana/index.js",
      "require": "./dist/solana/index.cjs",
      "default": "./dist/solana/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "start": "tsup src/index.ts --watch",
    "build": "tsup",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [
    "web3",
    "connect",
    "wallet",
    "wagmi",
    "viem",
    "zustand"
