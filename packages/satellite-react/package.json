{
  "name": "@tuwaio/satellite-react",
  "version": "0.6.3",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "L4 React package of Satellite Connect (TUWA): provider, store hook and EVM and Solana watcher components that keep wallet connections in sync with wallets and SIWX sessions.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./evm": {
      "types": "./dist/evm/index.d.ts",
      "import": "./dist/evm/index.js",
      "require": "./dist/evm/index.cjs",
      "default": "./dist/evm/index.js"
    },
    "./solana": {
      "types": "./dist/solana/index.d.ts",
      "import": "./dist/solana/index.js",
      "require": "./dist/solana/index.cjs",
      "default": "./dist/solana/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "start": "tsup src/index.ts --watch",
    "build": "tsup",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [
    "tuwa",
    "satellite-connect",
    "wallet-connection",
    "web3",
    "react",
    "hooks",
    "evm",
    "solana",
    "siwx",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/satellite-connect.git",
    "directory": "packages/satellite-react"
  },
  "homepage": "https://github.com/TuwaIO/satellite-connect",
  "bugs": {
    "url": "https://github.com/TuwaIO/satellite-connect/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
    "@tuwaio/orbit-core": ">=0.4",
    "@tuwaio/satellite-core": ">=0.7",
    "@tuwaio/satellite-evm": ">=0.7",
    "@tuwaio/satellite-solana": ">=0.7",
    "@wagmi/core": "3.x.x",
    "@wallet-standard/react": "1.x.x",
    "react": ">=19.2.3",
    "zustand": "5.x.x"
  },
  "peerDependenciesMeta": {
    "@tuwaio/orbit-core": {
      "optional": true
    },
    "@tuwaio/satellite-evm": {
      "optional": true
    },
    "@tuwaio/satellite-solana": {
      "optional": true
    },
    "@wagmi/core": {
      "optional": true
    },
    "@wallet-standard/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@tuwaio/orbit-core": "^0.4.0",
    "@tuwaio/satellite-core": "workspace:^",
    "@tuwaio/satellite-evm": "workspace:^",
    "@tuwaio/satellite-solana": "workspace:^",
    "@wagmi/core": "^3.6.5",
    "@wallet-standard/react": "^1.0.3",
    "react": "^19.3.0",
    "tsup": "^8.5.1",
    "viem": "^2.57.1",
    "typescript": "6.0.3",
    "zustand": "^5.0.15"
  }
}
