{
  "name": "@tuwaio/satellite-core",
  "version": "0.5.0",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "L3 core of Satellite Connect (TUWA): headless, framework-agnostic Zustand store for EVM and Solana wallet connections, with a chain adapter contract, auto-connect of the last wallet and the SIWX state type.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "start": "tsup src/index.ts --watch",
    "build": "tsup",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [
    "tuwa",
    "satellite-connect",
    "wallet-connection",
    "web3",
    "multi-chain",
    "evm",
    "solana",
    "zustand",
    "immer",
    "typescript",
    "framework-agnostic",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/satellite-connect.git",
    "directory": "packages/satellite-core"
  },
  "homepage": "https://github.com/TuwaIO/satellite-connect",
  "bugs": {
    "url": "https://github.com/TuwaIO/satellite-connect/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
    "@tuwaio/orbit-core": ">=0.3",
    "immer": "11.x.x",
    "zustand": "5.x.x"
  },
  "devDependencies": {
    "@tuwaio/orbit-core": "^0.3.1",
    "immer": "^11.1.18",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "zustand": "^5.0.15"
  }
}
