{
  "name": "@tuwaio/satellite-siwe-next-auth",
  "version": "0.3.6",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "Robust server-side session authentication adapter mapping cryptographic signatures to the SIWE standard and NextAuth.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.mjs",
      "default": "./dist/server/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "tsup src/index.ts --watch",
    "build": "tsup",
    "test": "vitest"
  },
  "keywords": [
    "web3",
    "siwe",
    "next-auth",
    "connect",
    "evm",
    "wagmi",
    "viem"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/satellite-connect.git",
    "directory": "packages/satellite-siwe-next-auth"
  },
  "homepage": "https://github.com/TuwaIO/satellite-connect",
  "bugs": {
    "url": "https://github.com/TuwaIO/satellite-connect/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
    "@wagmi/core": "3.x.x",
    "next": ">=16.1",
    "iron-session": "8.x.x",
    "react": ">=19.2.3",
    "viem": "2.x.x",
    "wagmi": "3.x.x"
  },
  "devDependencies": {
    "@wagmi/core": "^3.5.1",
    "@types/react": "^19.2.17",
    "next": "16.2.9",
    "iron-session": "^8.0.4",
    "react": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "viem": "^2.53.1",
    "wagmi": "^3.6.17"
  }
}
