    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "@wallet-standard/ui": "^1.0.3",
    "@wallet-standard/ui-registry": "^1.1.1",
    "tsup": "^8.5.1",
