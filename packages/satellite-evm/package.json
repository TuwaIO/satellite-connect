{
  "name": "@tuwaio/satellite-evm",
  "version": "0.6.1",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "L4 EVM package of Satellite Connect (TUWA): wallet adapter and connections watcher for wagmi connectors, a contract account check and wagmi config helpers, built on @wagmi/core and viem.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "start": "tsup src/index.ts --watch",
    "build": "tsup",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [
    "tuwa",
    "satellite-connect",
    "wallet-connection",
    "web3",
    "evm",
    "wagmi",
    "viem",
    "ens",
    "safe",
    "typescript",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/satellite-connect.git",
    "directory": "packages/satellite-evm"
  },
  "homepage": "https://github.com/TuwaIO/satellite-connect",
  "bugs": {
    "url": "https://github.com/TuwaIO/satellite-connect/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
    "@wagmi/core": "3.x.x",
    "viem": "2.x.x",
    "@tuwaio/orbit-core": ">=0.3",
    "@tuwaio/orbit-evm": ">=0.3",
    "@tuwaio/satellite-core": ">=0.5"
  },
  "devDependencies": {
    "@wagmi/core": "^3.6.5",
    "@tuwaio/orbit-core": "^0.3.1",
    "@tuwaio/orbit-evm": "^0.3.2",
    "@tuwaio/satellite-core": "workspace:^",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "viem": "^2.57.1",
    "vitest": "^5.0.2"
  }
}
