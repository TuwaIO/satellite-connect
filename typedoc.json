{
  "$schema": "https://typedoc.org/schema.json",
  "name": "API Reference for TUWA Satellite headless wallet connectivity and session state management.",
  "entryPoints": [
    "packages/satellite-core/src/index.ts",
    "packages/satellite-evm/src/index.ts",
    "packages/satellite-solana/src/index.ts",
    "packages/satellite-react/src/index.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**",
    "**/tests/**",
    "**/setup.ts"
  ],
  "entryPointStrategy": "expand",
  "tsconfig": "tsconfig.json",
  "plugin": ["typedoc-plugin-markdown", "typedoc-plugin-react"],
  "out": "apps/docs/src/content/apiReference",
  "readme": "none",
  "githubPages": false,
  "hideGenerator": true,
  "cleanOutputDir": true,
  "categorizeByGroup": true,
  "hideBreadcrumbs": true,
  "pageTitleTemplates": {
    "member": "{name}"
  }
}
