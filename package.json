{
  "name": "@tuwaio/satellite-connect-monorepo",
  "version": "0.0.1",
  "private": true,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.18.0",
  "description": "Monorepo for Satellite: Layer 3 and Layer 4 (L3/L4) headless wallet connection orchestration and cryptographic identity layers for the TUWA Ecosystem.",
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" build",
    "postinstall": "pnpm build",
    "test": "pnpm --filter \"./packages/**\" test",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --fix --ext .ts,.tsx",
    "format": "prettier --write .",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf '{}' + && find . -name dist -type d -prune -exec rm -rf '{}' + && rm -rf .turbo",
    "docs:gen": "typedoc && cp apps/docs/src/content/apiReference-meta.tsx apps/docs/src/content/apiReference/_meta.tsx",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/satellite-connect.git"
  },
  "homepage": "https://github.com/TuwaIO/satellite-connect",
  "bugs": {
    "url": "https://github.com/TuwaIO/satellite-connect/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semantic-release": "^25.0.8",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-plugin-react": "^0.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
